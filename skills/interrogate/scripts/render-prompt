#!/usr/bin/env python3
"""Render one interrogate reviewer prompt from references/reviewer-prompt.md.

Run from anywhere in the reviewed repo. Writes prompt.md into a fresh temp directory and prints its path.
"""
import argparse
import posixpath
import re
import subprocess
import sys
import tempfile
from pathlib import Path

REFERENCES = Path(__file__).resolve().parent.parent / "references"
DONT_FLAG = Path.home() / ".agents" / "pedantic.md"
PLACEHOLDER = re.compile(r"\{([A-Z_]+)\}")


def decoded(data):
    return data.decode("utf-8", "replace")


def git(*args):
    result = subprocess.run(["git", *args], capture_output=True)
    if result.returncode != 0:
        sys.exit(f"render-prompt: git {' '.join(args)}: {decoded(result.stderr).strip()}")
    return decoded(result.stdout)


def fenced(text, lang):
    longest = max((len(run) for run in re.findall(r"`+", text)), default=0)
    fence = "`" * max(3, longest + 1)
    body = text.rstrip("\n")
    return f"{fence}{lang}\n{body}\n{fence}"


def quoted(text):
    lines = text.replace("\r\n", "\n").split("\n")
    return "\n".join(f"> {line}".rstrip() for line in lines)


def excluded(path, merge_base, head):
    norm = posixpath.normpath(path)
    if posixpath.isabs(norm) or norm == "." or norm.startswith("../") or norm == "..":
        sys.exit(f"render-prompt: --exclude {path}: not a path inside the repo, relative to its root")
    if not git("diff-tree", "-r", "--no-renames", "--name-only", merge_base, head, "--", f":(top,literal){norm}"):
        sys.exit(f"render-prompt: --exclude {path}: matches no changed path")
    return f":(top,exclude,literal){norm}"


def reference(name):
    return (REFERENCES / name).read_text(encoding="utf-8")


def dont_flag():
    if not DONT_FLAG.exists():
        return "None."
    return DONT_FLAG.read_text(encoding="utf-8").strip() or "None."


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--intent", required=True, help="the Step 2 intent paragraph, or - to read it from stdin")
    parser.add_argument("--head", required=True, help="the reviewed commit")
    parser.add_argument("--base", required=True, help="diff from the merge base of this ref and --head")
    parser.add_argument("--exclude", action="append", default=[], metavar="PATH",
                        help="leave PATH, relative to the repo root, out of the diff (repeatable), e.g. flake.lock;"
                             " exclude both sides of a rename, or its directory")
    parser.add_argument("--runner", metavar="SCRIPT",
                        help="name this reviewer the runner of SCRIPT, which writes outside the worktree")
    parser.add_argument("--prior", metavar="FILE",
                        help="findings earlier rounds of this review already raised, which reviewers don't report again")
    args = parser.parse_args()

    head = git("rev-parse", "--verify", f"{args.head}^{{commit}}").strip()
    git("rev-parse", "--verify", f"{args.base}^{{commit}}")
    intent = (decoded(sys.stdin.buffer.read()) if args.intent == "-" else args.intent).strip()
    if not intent:
        sys.exit("render-prompt: empty intent")
    merge_base = git("merge-base", args.base, head).strip()
    pathspec = ["--", *(excluded(path, merge_base, head) for path in args.exclude)]
    diff = git("-c", "core.quotePath=false", "diff-tree", "-p", "-r", "-M", merge_base, head, *pathspec)
    if not diff.strip():
        sys.exit(f"render-prompt: empty diff for {args.base}...{head}")

    runner = ""
    if args.runner:
        runner = f" The prompt names you the runner of `{args.runner}`, so run it end to end."

    prior = "None."
    if args.prior:
        try:
            prior = Path(args.prior).read_text(encoding="utf-8").strip() or "None."
        except OSError as err:
            sys.exit(f"render-prompt: --prior {args.prior}: {err.strerror}")

    values = {
        "INTENT": quoted(intent),
        "HEAD_SHA": head,
        "DIFF_OR_FILES": fenced(diff, "diff"),
        "RUBRIC_CONTENTS": reference("rubric.md"),
        "CODE_QUALITY_CONTENTS": reference("code-quality-review.md"),
        "EXECUTE_AND_PROBE_CONTENTS": reference("execute-and-probe.md"),
        "DONT_FLAG": dont_flag(),
        "PRIOR_FINDINGS": prior,
        "RUNNER": runner,
    }
    template = reference("reviewer-prompt.md").split("\n---\n", 1)[1]
    slots = set(PLACEHOLDER.findall(template))
    if slots != values.keys():
        sys.exit(f"render-prompt: template slots {sorted(slots)} don't match values {sorted(values)}")
    prompt = PLACEHOLDER.sub(lambda m: values[m.group(1)], template).lstrip("\n")

    out = Path(tempfile.mkdtemp(prefix="interrogate-")) / "prompt.md"
    out.write_text(prompt, encoding="utf-8")
    print(out)


if __name__ == "__main__":
    main()
