#!/usr/bin/env bash
# Prepare one interrogate reviewer: render its prompt and check out <head> in a worktree beside it.
# Usage: prepare-reviewer <render-prompt flags>   (run from the reviewed repo's git checkout)
# Prints "prompt=<path> wt=<path>". The worktree is <prompt dir>/wt, so the cleanup loop over prompt
# dirs removes it. A failure, or INT/TERM/HUP once the prompt is written, leaves neither behind.
set -euo pipefail

head="" flags=()
while [ $# -gt 0 ]; do
  case $1 in
    --head) head=${2:?}; shift 2 ;;
    *) flags+=("$1"); shift ;;
  esac
done
[ -n "$head" ] || { echo "prepare-reviewer: --head <sha> is required" >&2; exit 2; }
git rev-parse --git-dir >/dev/null 2>&1 ||
  { echo "prepare-reviewer: $PWD is not a git checkout; run it from the reviewed repo's git checkout (a jj workspace has none)" >&2; exit 2; }

sha=$(git rev-parse --verify -q "$head^{commit}") || { echo "prepare-reviewer: --head $head: not a commit" >&2; exit 2; }
# git worktree add runs in the background so a signal is handled at once, not after checkout hooks.
p="" add=""
discard() {
  [ -z "$add" ] || { kill "$add" 2>/dev/null || true; wait "$add" 2>/dev/null || true; }
  [ -z "$p" ] || { git worktree remove -f -f "${p%/*}/wt" 2>/dev/null || true; rm -rf "${p%/*}"; }
}
trap 'discard; exit 130' INT TERM HUP
p=$("$(dirname "$0")/render-prompt" --head "$sha" "${flags[@]}")
git worktree add -q --detach "${p%/*}/wt" "$sha" &
add=$!
wait "$add" || { add=""; discard; exit 1; }
add=""
echo "prompt=$p wt=${p%/*}/wt"
