#!/usr/bin/env bash
# Run one codex interrogate reviewer: prepare its prompt and worktree (prepare-reviewer), run codex
# exec in the worktree, and remove the worktree when codex exits.
# Usage: run-codex-reviewer --model <model> --effort <effort> <render-prompt flags>
# Prints "prompt=<path> out=<path>" before codex starts; codex writes its review to out=.
set -euo pipefail

model="" effort="" flags=()
while [ $# -gt 0 ]; do
  case $1 in
    --model) model=${2:?}; shift 2 ;;
    --effort) effort=${2:?}; shift 2 ;;
    *) flags+=("$1"); shift ;;
  esac
done
if [ -z "$model" ] || [ -z "$effort" ]; then
  echo "run-codex-reviewer: --model and --effort are required" >&2
  exit 2
fi

pid="" wt=""
trap '[ -z "$wt" ] || git worktree remove -f -f "$wt" || true' EXIT
trap '[ -n "$pid" ] && kill "$pid" 2>/dev/null; wait; exit 130' INT TERM HUP
ready=$("$(dirname "$0")/prepare-reviewer" "${flags[@]}")
p=${ready#prompt=}
p=${p% wt=*}
dir=${p%/*}
wt=$dir/wt
echo "prompt=$p out=$dir/out.md"

codex exec -m "$model" -c "model_reasoning_effort=$effort" --dangerously-bypass-approvals-and-sandbox \
  -C "$wt" -o "$dir/out.md" - < "$p" &
pid=$!
wait "$pid"
