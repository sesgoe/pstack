#!/usr/bin/env bash
# Run one codex interrogate reviewer: prepare its prompt and worktree (prepare-reviewer), run codex
# exec in the worktree, and remove the worktree when codex exits.
# Usage: run-codex-reviewer --model <model> --effort <effort> <render-prompt flags>
# Prints "prompt=<path> out=<path>" before codex starts; codex writes its review to out=.
set -euo pipefail

model="" effort="" flags=()
while [ $# -gt 0 ]; do
  case $1 in
    --model) model=${2:?}; shift 2 ;;
    --effort) effort=${2:?}; shift 2 ;;
    *) flags+=("$1"); shift ;;
  esac
done
if [ -z "$model" ] || [ -z "$effort" ]; then
  echo "run-codex-reviewer: --model and --effort are required" >&2
  exit 2
fi

# prepare-reviewer and codex each run in the background, so a signal reaches the running child at
# once: prepare-reviewer discards its own prompt dir and worktree, and the EXIT trap removes codex's.
p="" wt="" ready=$(mktemp)
read_ready() { local line; line=$(< "$ready"); [ -z "$line" ] || { p=${line#prompt=}; p=${p% wt=*}; wt=${line##* wt=}; }; }
trap '[ -n "$wt" ] || read_ready; rm -f "$ready"; [ -z "$wt" ] || git worktree remove -f -f "$wt" || true' EXIT
# shellcheck disable=SC2046 # jobs -p is one PID per word
trap 'kill $(jobs -p) 2>/dev/null || true; wait; exit 130' INT TERM HUP
"$(dirname "$0")/prepare-reviewer" "${flags[@]}" <&0 > "$ready" &
wait "$!"
read_ready
dir=${p%/*}
echo "prompt=$p out=$dir/out.md"

codex exec -m "$model" -c "model_reasoning_effort=$effort" --dangerously-bypass-approvals-and-sandbox \
  -C "$wt" -o "$dir/out.md" - < "$p" &
wait "$!"
